---
import BaseLayout from "~/layouts/BaseLayout.astro";
import StandardsPage from "~/components/pages/StandardsPage.astro";
import { pages } from "~/content/pages.en";

const copy = pages.standards;
---

<BaseLayout
  locale="en"
  route="standards"
  title={copy.meta.title}
  description={copy.meta.description}
>
  <StandardsPage copy={copy} locale="en" />
</BaseLayout>
