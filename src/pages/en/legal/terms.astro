import LegalPage from "~/components/pages/LegalPage.astro";
import { pages } from "~/content/pages.en";

const copy = pages.terms;
---

<BaseLayout
  locale="en"
  route="legal/terms"
  title={copy.meta.title}
  description={copy.meta.description}
>
  <LegalPage copy={copy} />
</BaseLayout>
