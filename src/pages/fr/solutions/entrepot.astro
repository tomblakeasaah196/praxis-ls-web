---
import { useTranslations } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DemoForm from '../../../components/DemoForm.astro';

const locale = 'fr';
const t = useTranslations(locale);
---

<BaseLayout 
  locale={locale}
  title="Entrepôt — Praxis LS"
  description="Gestion des entrées, sorties et stocks, avec chiffrage qui alimente le grand livre. Les mouvements de stock et bons de livraison s'imputent d'eux-mêmes."
>
  <section class="solution-hero">
    <div class="container">
      <p class="eyebrow">Solutions</p>
      <h1>{t['solutions.warehouse.title']}</h1>
      <p class="solution-hero__intro">{t['solutions.warehouse.intro']}</p>
    </div>
  </section>

  <section class="solution-content section">
    <div class="container">
      <h2>Ce que vous obtenez</h2>
      <ul class="feature-list">
        <li>
          <strong>Réception</strong> — création du bon de réception, vérification des quantités, gestion des écarts
        </li>
        <li>
          <strong>Gestion des stocks</strong> — emplacements, zones, suivi des capacités
        </li>
        <li>
          <strong>Préparation et emballage</strong> — planification des vagues, optimisation des tournées, listes de colisage
        </li>
        <li>
          <strong>Expédition</strong> — planification des sorties, chargement, génération des bons de livraison
        </li>
        <li>
          <strong>Évaluation des stocks</strong> — coût réel, coût standard, FIFO — selon les règles SYSCOHADA
        </li>
        <li>
          <strong>Inventaire tournant</strong> — vérification continue, reporting des écarts
        </li>
      </ul>

      <h2>Comment ça s'impute au grand livre</h2>
      <p>Chaque bon de réception, chaque mouvement de stock, chaque bon de livraison porte ses propres règles d'imputation. Les écritures d'évaluation des stocks se font automatiquement en fin de mois.</p>
    </div>
  </section>

  <section class="solution-cta section--full">
    <div class="container container--narrow">
      <h2>Voyez-le avec votre exploitation</h2>
      <p>Trente minutes, vos dossiers, vos questions. Nous vous montrons le grand livre qui se trouve derrière.</p>
      <a href="/fr/contact" class="btn btn--primary btn--lg">Demander une démo</a>
    </div>
  </section>

  <DemoForm locale={locale} />
</BaseLayout>

<style>
  .solution-hero {
    padding-block: var(--space-20);
    background-color: var(--brand-carbon);
  }

  .solution-hero h1 {
    font-size: var(--text-display-xl);
    margin-block: var(--space-4);
    color: var(--brand-ink);
  }

  .solution-hero__intro {
    font-size: var(--text-body-l);
    color: var(--brand-ink-muted);
    max-width: 60ch;
  }

  .solution-content {
    background-color: var(--brand-bg);
  }

  .solution-content h2 {
    font-size: var(--text-display-m);
    margin-bottom: var(--space-5);
    margin-top: var(--space-10);
  }

  .solution-content h2:first-child {
    margin-top: 0;
  }

  .solution-content p {
    color: var(--brand-ink-muted);
    margin-bottom: var(--space-4);
  }

  .feature-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .feature-list li {
    padding: var(--space-4);
    background-color: var(--brand-surface);
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-md);
  }

  .feature-list strong {
    color: var(--brand-ink-orange);
  }

  .solution-cta {
    padding-block: var(--space-20);
    background-color: var(--brand-carbon);
    text-align: center;
  }

  .solution-cta h2 {
    font-size: var(--text-display-l);
    color: var(--brand-ink);
    margin-bottom: var(--space-4);
  }

  .solution-cta p {
    color: var(--brand-ink-muted);
    margin-bottom: var(--space-8);
    margin-inline: auto;
  }
</style>
