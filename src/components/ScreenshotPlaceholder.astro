---
interface Props {
  id: string;
  label: string;
  hint?: string;
}

const { id, label, hint } = Astro.props;
---

<div class="screenshot-placeholder" data-screenshot={id}>
  <div class="screenshot-placeholder__content">
    <svg class="screenshot-placeholder__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
      <circle cx="8.5" cy="8.5" r="1.5"/>
      <polyline points="21 15 16 10 5 21"/>
    </svg>
    <span class="screenshot-placeholder__label">{label}</span>
    <span class="screenshot-placeholder__text">{hint || 'See swap procedure in HANDOFF.md'}</span>
  </div>
</div>

<style>
  .screenshot-placeholder {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: var(--brand-surface);
    border: 2px dashed var(--brand-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .screenshot-placeholder__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-6);
  }

  .screenshot-placeholder__icon {
    width: 48px;
    height: 48px;
    color: var(--brand-ink-muted);
    opacity: 0.5;
  }

  .screenshot-placeholder__text {
    font-size: var(--text-caption);
    color: var(--brand-ink-muted);
    text-align: center;
  }

  .screenshot-placeholder__label {
    font-family: var(--brand-font-mono);
    font-size: var(--text-eyebrow);
    color: var(--brand-ink-slate);
    letter-spacing: 0.05em;
    padding: var(--space-1) var(--space-3);
    background-color: var(--brand-surface);
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-sm);
  }
</style>
