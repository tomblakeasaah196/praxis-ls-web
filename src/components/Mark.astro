---
/**
 * The Praxis LS mark — hand-authored SVG, theme-aware through the brand tokens.
 *
 * ⚠️ OPEN. The drawn logo asset was not part of the specification handed over,
 * so this is an INTERPRETATION of BRAND_GUIDELINES.md §2's construction note:
 * "an isometric cube of three slate faces, overlaid with an orange node
 * network — a central node, radiating spokes, terminal dots". It observes the
 * rules that are written down (slate + orange, no gradient, no bevel, no
 * rotation, no tagline, glyph-only below 32px) but it is not the real mark and
 * must be replaced by the cut asset before launch. Logged in HANDOFF.md § OPEN.
 *
 * Naming follows the table in §2: the drawn wordmark is `PRAXIS-LS`, prose is
 * `Praxis LS`. That table itself carries an open question, which §6 of the
 * brief says explicitly not to resolve here — so it is not resolved here.
 */
interface Props {
  /** `lockup` is mark + wordmark; `glyph` is the node cluster alone, which is
   *  what survives at favicon size. */
  variant?: "lockup" | "glyph";
  class?: string;
}

const { variant = "lockup", class: className } = Astro.props;
---

<span class:list={["mark", `mark--${variant}`, className]}>
  {
    /* In the lockup the drawing is decorative and the WORDMARK carries the
      name — a link labelled "Praxis LS" while showing "PRAXIS-LS" is an
      accessible name that does not contain its own visible text, which is a
      real problem for anyone using voice control: they say what they see and
      nothing happens. The glyph has no visible text, so there the drawing is
      what names it. */
  }
  <svg
    class="mark__cube"
    viewBox="0 0 32 32"
    role={variant === "glyph" ? "img" : undefined}
    aria-label={variant === "glyph" ? "Praxis LS" : undefined}
    aria-hidden={variant === "glyph" ? undefined : "true"}
    focusable="false"
    xmlns="http://www.w3.org/2000/svg"
  >
    {
      variant === "lockup" && (
        <g class="mark__structure">
          {/* Three faces of one isometric cube: the container. */}
          <path class="mark__face mark__face--top" d="M16 3.2 27 9.6 16 16 5 9.6Z" />
          <path class="mark__face mark__face--left" d="M5 9.6 16 16v12.8L5 22.4Z" />
          <path class="mark__face mark__face--right" d="M27 9.6 16 16v12.8l11-6.4Z" />
        </g>
      )
    }
    <g class="mark__network">
      {
        /* The node network: a central node, radiating spokes, terminal dots.
          1px connectors, per BRAND_GUIDELINES.md §2. */
      }
      <path
        d="M16 16 16 7.4M16 16 23.4 11.7M16 16 23.4 20.3M16 16 16 24.6M16 16 8.6 20.3M16 16 8.6 11.7"
      ></path>
      <circle cx="16" cy="7.4" r="1.5"></circle>
      <circle cx="23.4" cy="11.7" r="1.5"></circle>
      <circle cx="23.4" cy="20.3" r="1.5"></circle>
      <circle cx="16" cy="24.6" r="1.5"></circle>
      <circle cx="8.6" cy="20.3" r="1.5"></circle>
      <circle cx="8.6" cy="11.7" r="1.5"></circle>
      <circle class="mark__hub" cx="16" cy="16" r="2.7"></circle>
    </g>
  </svg>
  {variant === "lockup" && <span class="mark__wordmark">PRAXIS-LS</span>}
</span>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .mark__cube {
    inline-size: 26px;
    block-size: 26px;
    flex: none;
    overflow: visible;
  }

  .mark--glyph .mark__cube {
    inline-size: 20px;
    block-size: 20px;
  }

  /* Slate structure, orange network — the two-part system, never recoloured. */
  .mark__face {
    fill: var(--brand-slate);
  }

  .mark__face--top {
    opacity: 0.95;
  }

  .mark__face--left {
    opacity: 0.6;
  }

  .mark__face--right {
    opacity: 0.4;
  }

  .mark__network path {
    stroke: var(--brand-orange);
    stroke-width: 1;
    fill: none;
  }

  .mark__network circle {
    fill: var(--brand-orange);
  }

  .mark__hub {
    stroke: var(--brand-bg);
    stroke-width: 1.5;
  }

  .mark__wordmark {
    font-family: var(--brand-font-display);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: var(--brand-tracking-wordmark);
    color: var(--brand-ink);
    white-space: nowrap;
  }
</style>
