---
import { type Locale, useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const roles = [
  { value: 'dg', label: t['form.roleDG'] },
  { value: 'operations', label: t['form.roleOperations'] },
  { value: 'finance', label: t['form.roleFinance'] },
  { value: 'it', label: t['form.roleIT'] },
  { value: 'other', label: t['form.roleOther'] },
];

const countries = [
  { code: 'CM', name: 'Cameroon' },
  { code: 'CI', name: "Côte d'Ivoire" },
  { code: 'GA', name: 'Gabon' },
  { code: 'SN', name: 'Sénégal' },
  { code: 'FR', name: 'France' },
  { code: 'BE', name: 'Belgique' },
  { code: 'OTHER', name: 'Other' },
];
---

<section class="demo-form-section">
  <div class="demo-form__container container container--narrow">
    <div class="demo-form__header">
      <h2 class="demo-form__title">{t['form.title']}</h2>
      <p class="demo-form__subtitle">{t['form.subtitle']}</p>
    </div>

    <form class="demo-form" data-demo-form novalidate>
      <div class="demo-form__grid">
        <div class="form-group">
          <label for="name" class="form-label">{t['form.name']}</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            class="form-input" 
            required 
            autocomplete="name"
          />
        </div>

        <div class="form-group">
          <label for="email" class="form-label">{t['form.email']}</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-input" 
            required 
            autocomplete="email"
          />
        </div>

        <div class="form-group">
          <label for="company" class="form-label">{t['form.company']}</label>
          <input 
            type="text" 
            id="company" 
            name="company" 
            class="form-input" 
            required 
            autocomplete="organization"
          />
        </div>

        <div class="form-group">
          <label for="country" class="form-label">{t['form.country']}</label>
          <select id="country" name="country" class="form-input" required>
            <option value="">Select…</option>
            {countries.map(c => (
              <option value={c.code}>{c.name}</option>
            ))}
          </select>
        </div>

        <div class="form-group">
          <label for="role" class="form-label">{t['form.role']}</label>
          <select id="role" name="role" class="form-input" required>
            <option value="">Select…</option>
            {roles.map(r => (
              <option value={r.value}>{r.label}</option>
            ))}
          </select>
        </div>

        <div class="form-group form-group--full">
          <label for="current">
            {t['form.current']}
            <span class="form-label__optional">({t['form.currentOptional']})</span>
          </label>
          <input 
            type="text" 
            id="current" 
            name="current" 
            class="form-input" 
            autocomplete="off"
          />
        </div>
      </div>

      <button type="submit" class="btn btn--primary demo-form__submit">
        {t['form.submit']}
      </button>

      <div class="demo-form__status" data-form-status hidden>
        <div class="demo-form__success" data-form-success hidden>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <span>{t['form.success']}</span>
        </div>
        <div class="demo-form__error" data-form-error hidden>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="15" y1="9" x2="9" y2="15"/>
            <line x1="9" y1="9" x2="15" y2="15"/>
          </svg>
          <span>{t['form.error']}</span>
        </div>
      </div>
    </form>
  </div>
</section>

<style>
  .demo-form-section {
    padding-block: var(--space-20);
    background-color: var(--brand-surface);
  }

  .demo-form__header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .demo-form__title {
    font-size: var(--text-display-l);
    margin-bottom: var(--space-3);
  }

  .demo-form__subtitle {
    font-size: var(--text-body-l);
    color: var(--brand-ink-muted);
  }

  .demo-form__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .form-group--full {
    grid-column: 1 / -1;
  }

  .form-label__optional {
    font-weight: 400;
    color: var(--brand-ink-muted);
  }

  .demo-form__submit {
    width: 100%;
    padding: var(--space-4) var(--space-6);
    font-size: var(--text-body-l);
  }

  .demo-form__status {
    margin-top: var(--space-6);
  }

  .demo-form__success,
  .demo-form__error {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--text-body);
  }

  .demo-form__success {
    background-color: color-mix(in srgb, var(--brand-ok) 15%, transparent);
    color: var(--brand-ok);
  }

  .demo-form__error {
    background-color: color-mix(in srgb, var(--brand-danger) 15%, transparent);
    color: var(--brand-danger);
  }

  @media (max-width: 640px) {
    .demo-form__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Demo form handler
  // The actual submission is wired behind this function for later integration
  function wireDemoFormSubmission(formData: FormData): Promise<void> {
    // TODO: Wire to actual destination (inbox, CRM, calendar)
    // For now, simulate success
    return new Promise((resolve) => {
      console.log('Demo form submitted:', Object.fromEntries(formData));
      setTimeout(resolve, 1000);
    });
  }

  function validateEmail(email: string): boolean {
    // Reject common free providers but don't block
    const domain = email.split('@')[1]?.toLowerCase();
    return Boolean(domain && domain.includes('.'));
  }

  const form = document.querySelector('[data-demo-form]') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const email = formData.get('email') as string;
      
      // Basic validation
      if (!validateEmail(email)) {
        const emailInput = form.querySelector('#email') as HTMLInputElement;
        emailInput.setCustomValidity('Please enter a valid work email');
        emailInput.reportValidity();
        return;
      }
      
      const submitBtn = form.querySelector('[type="submit"]') as HTMLButtonElement;
      const status = form.querySelector('[data-form-status]') as HTMLElement;
      const success = form.querySelector('[data-form-success]') as HTMLElement;
      const error = form.querySelector('[data-form-error]') as HTMLElement;
      
      submitBtn.disabled = true;
      submitBtn.textContent = '…';
      
      try {
        await wireDemoFormSubmission(formData);
        
        status.removeAttribute('hidden');
        success.removeAttribute('hidden');
        error.setAttribute('hidden', '');
        form.reset();
      } catch {
        status.removeAttribute('hidden');
        error.removeAttribute('hidden');
        success.setAttribute('hidden', '');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = submitBtn.dataset.originalText || 'Request a demo';
      }
    });

    // Store original submit text
    const submitBtn = form.querySelector('[type="submit"]') as HTMLButtonElement;
    if (submitBtn) {
      submitBtn.dataset.originalText = submitBtn.textContent || 'Request a demo';
    }
  }
</script>
