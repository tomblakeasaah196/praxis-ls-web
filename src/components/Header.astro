---
/**
 * Sticky, 64px, --brand-bg at 88% behind a blur, a 1px rule once the page has
 * scrolled (guide §3.1). Five items, one sheet on mobile, and the CTA is the
 * only orange thing in it.
 *
 * "Solutions" is a menu over the five solution pages. It could not be one in
 * the first change — the pages did not exist — and pointing it at the coverage
 * grid was a placeholder, recorded as a deviation. It is a DISCLOSURE, not an
 * ARIA menu: a button that shows and hides a list of ordinary links. The APG's
 * menu/menuitem pattern is for application menus, where arrow keys replace Tab
 * and a link stops being a link; navigation that behaves that way surprises
 * everyone who has learned how a website works.
 *
 * "Product" still points at a homepage section: the URL map in guide §2 has no
 * `/product` page to point it at. Deviation logged in HANDOFF.md.
 */
import Mark from "./Mark.astro";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { UI } from "~/i18n/ui";
import { solutionNav } from "~/content/solutions";
import { href, type Locale, type RouteKey } from "~/i18n/routes";

interface Props {
  locale: Locale;
  route: RouteKey;
}

const { locale, route } = Astro.props;
const ui = UI[locale];
const home = href("home", locale);

const solutions = solutionNav(locale).map((entry) => ({
  ...entry,
  url: href(entry.route, locale),
  current: route === entry.route,
}));
const onSolution = solutions.some((entry) => entry.current);

const before = [{ label: ui.nav.product, href: `${home}#spine`, current: false }];
const after = [
  { label: ui.nav.security, href: href("security", locale), current: route === "security" },
  { label: ui.nav.pricing, href: href("pricing", locale), current: route === "pricing" },
  { label: ui.nav.about, href: href("about", locale), current: route === "about" },
];
---

<header class="header" data-header>
  <div class="header__inner shell">
    <a class="header__brand" href={home}>
      <Mark />
    </a>

    <nav class="header__nav" aria-label={ui.nav.label}>
      <ul class="header__list">
        {
          before.map((item) => (
            <li>
              <a href={item.href} aria-current={item.current ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="header__menu-holder" data-menu-root>
          <button
            type="button"
            class="header__menu-button"
            data-menu-button
            aria-expanded="false"
            aria-controls="solutions-menu"
            data-current={onSolution ? "" : undefined}
          >
            {ui.nav.solutions}
            <svg
              class="header__chevron"
              viewBox="0 0 12 12"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.4" fill="none"
              ></path>
            </svg>
          </button>
          <div class="header__menu" id="solutions-menu" hidden data-menu>
            <ul>
              {
                solutions.map((entry) => (
                  <li>
                    <a href={entry.url} aria-current={entry.current ? "page" : undefined}>
                      <span class="header__menu-label">{entry.label}</span>
                      <span class="header__menu-blurb">{entry.blurb}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        {
          after.map((item) => (
            <li>
              <a href={item.href} aria-current={item.current ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__tools">
      <LanguageSwitcher locale={locale} route={route} />
      <ThemeToggle locale={locale} />
      <a class="btn btn--primary btn--small header__cta" href={href("contact", locale)}>
        {ui.cta.bookDemo}
      </a>
      <button
        type="button"
        class="header__burger"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="header-sheet"
        aria-label={ui.nav.openMenu}
        data-open-label={ui.nav.openMenu}
        data-close-label={ui.nav.closeMenu}
      >
        <svg
          viewBox="0 0 20 20"
          aria-hidden="true"
          focusable="false"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" fill="none"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  {
    /* ONE sheet on mobile, not a nested menu system (guide §3.1). The five
      solution pages are listed inside it under a heading rather than behind a
      second disclosure: a menu inside a sheet is the "dropdown on mobile" the
      guide rules out, and it would put two Escape targets on one screen. */
  }
  <div class="header__sheet" id="header-sheet" hidden data-nav-sheet>
    <ul class="header__sheet-list shell">
      {
        before.map((item) => (
          <li>
            <a href={item.href} aria-current={item.current ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <h2 class="header__sheet-heading" id="sheet-solutions">{ui.nav.solutions}</h2>
        <ul class="header__sheet-sub" aria-labelledby="sheet-solutions">
          {
            solutions.map((entry) => (
              <li>
                <a href={entry.url} aria-current={entry.current ? "page" : undefined}>
                  {entry.label}
                </a>
              </li>
            ))
          }
        </ul>
      </li>
      {
        after.map((item) => (
          <li>
            <a href={item.href} aria-current={item.current ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a class="btn btn--primary header__sheet-cta" href={href("contact", locale)}>
          {ui.cta.bookDemo}
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: var(--header-veil);
    backdrop-filter: blur(12px);
    border-block-end: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease);
  }

  .header[data-scrolled] {
    border-block-end-color: var(--brand-line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    block-size: var(--header-height);
  }

  .header__brand {
    text-decoration: none;
    flex: none;
  }

  .header__nav {
    margin-inline-start: var(--space-l);
    flex: 1;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .header__list a,
  .header__sheet-list a {
    color: var(--brand-ink-muted);
    text-decoration: none;
    font-size: var(--step-caption);
    font-weight: 500;
    white-space: nowrap;
  }

  .header__list a:hover,
  .header__sheet-list a:hover {
    color: var(--brand-ink);
  }

  .header__list a[aria-current="page"] {
    color: var(--brand-ink-orange);
  }

  /* ── The Solutions menu ────────────────────────────────────────────────── */

  .header__menu-holder {
    position: relative;
  }

  .header__menu-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--brand-ink-muted);
    font-family: inherit;
    font-size: var(--step-caption);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
  }

  .header__menu-button:hover {
    color: var(--brand-ink);
  }

  .header__menu-button[data-current] {
    color: var(--brand-ink-orange);
  }

  .header__chevron {
    inline-size: 12px;
    block-size: 12px;
    transition: transform var(--duration-fast) var(--ease);
  }

  .header__menu-button[aria-expanded="true"] .header__chevron {
    transform: rotate(180deg);
  }

  .header__menu {
    position: absolute;
    inset-block-start: calc(100% + var(--space-s));
    inset-inline-start: calc(var(--space-s) * -1);
    inline-size: max-content;
    max-inline-size: 22rem;
    padding: var(--space-2xs);
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-l);
    background: var(--brand-bg);
    box-shadow: 0 12px 32px color-mix(in srgb, var(--brand-carbon) 32%, transparent);
  }

  .header__menu ul {
    display: grid;
    gap: 1px;
  }

  .header__menu a {
    display: grid;
    gap: 1px;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-m);
    white-space: normal;
  }

  .header__menu a:hover {
    background: var(--surface-raised);
  }

  .header__menu-label {
    display: block;
    color: var(--brand-ink);
    font-weight: 600;
  }

  .header__menu a[aria-current="page"] .header__menu-label {
    color: var(--brand-ink-orange);
  }

  .header__menu-blurb {
    display: block;
    color: var(--brand-ink-muted);
    font-size: var(--step-eyebrow);
    line-height: 1.4;
  }

  .header__sheet-heading {
    font-size: var(--step-eyebrow);
    font-family: var(--brand-font-display);
    letter-spacing: var(--brand-tracking-eyebrow);
    text-transform: uppercase;
    color: var(--brand-ink-slate);
    margin: 0 0 var(--space-2xs);
  }

  .header__sheet-sub {
    display: grid;
    gap: var(--space-2xs);
    padding-inline-start: var(--space-s);
    border-inline-start: 1px solid var(--brand-line);
  }

  .header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-inline-start: auto;
  }

  .header__burger {
    display: none;
    align-items: center;
    justify-content: center;
    inline-size: 36px;
    block-size: 36px;
    padding: 0;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-m);
    background: transparent;
    color: var(--brand-ink-muted);
    cursor: pointer;
  }

  .header__burger svg {
    inline-size: 18px;
    block-size: 18px;
  }

  .header__sheet {
    border-block-start: 1px solid var(--brand-line);
    background: var(--brand-bg);
    padding-block: var(--space-s) var(--space-m);
  }

  .header__sheet-list {
    display: grid;
    gap: var(--space-s);
  }

  .header__sheet-list a {
    font-size: var(--step-body);
    display: inline-block;
    padding-block: var(--space-3xs);
  }

  .header__sheet-cta {
    inline-size: 100%;
  }

  /* The nav collapses before the FR labels do — "Sécurité · Tarifs · À propos"
     runs wider than its English peer (glossary §5.12). */
  @media (width < 62rem) {
    .header__nav {
      display: none;
    }

    .header__burger {
      display: inline-flex;
    }

    .header__cta {
      display: none;
    }
  }
</style>
