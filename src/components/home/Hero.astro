---
/**
 * Guide §3.2. Full-bleed carbon, left column of words, right column of software.
 * No perspective mockup, no floating browser chrome: it is software, so it is
 * shown as software.
 */
import Screenshot from "~/components/Screenshot.astro";
import type { HomeCopy } from "~/content/types";
import { href, type Locale } from "~/i18n/routes";

interface Props {
  copy: HomeCopy;
  locale: Locale;
}

const { copy, locale } = Astro.props;
---

<section class="hero section section--flush">
  <div class="shell hero__inner">
    <div class="hero__words">
      <p class="eyebrow">{copy.hero.eyebrow}</p>
      <h1 class="hero__h1">{copy.hero.h1}</h1>
      <p class="hero__sub lede">{copy.hero.sub}</p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href={href("contact", locale)}>{copy.hero.ctaPrimary}</a>
        <a class="btn btn--secondary" href="#control-tower">{copy.hero.ctaSecondary}</a>
      </div>
    </div>

    <div class="hero__shot">
      <Screenshot
        screen="operation-file"
        theme="dark"
        locale={locale}
        alt={copy.hero.screenshotAlt}
        priority
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block-start: clamp(2.5rem, 1.5rem + 5vw, 5rem);
  }

  .hero__inner {
    display: grid;
    gap: clamp(2rem, 1rem + 5vw, 4rem);
    align-items: center;
  }

  .hero__words > * + * {
    margin-block-start: var(--space-m);
  }

  .hero__h1 {
    max-width: 20ch;
  }

  .hero__sub {
    max-width: 52ch;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  @media (width >= 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }
  }
</style>
