---
/**
 * Guide §3.13. The SHAPE, never the number.
 *
 * Three tiers by scale and commitment, not by module: an operator with four
 * trucks needs Fleet and is small, a 200-person forwarder needs none of it and
 * is the largest deal on the list. Module-gating charges the wrong people.
 *
 * No figure appears here or on /pricing. Every pricing number is OPEN (brief
 * §6), and the guide's position is that publishing the shape while withholding
 * the number is honest — publishing neither reads as evasive.
 *
 * DRAFT COPY: the section heading, the intro and the French tier descriptions.
 * The guide gives the tier table in English only.
 */
import type { HomeCopy } from "~/content/types";
import { href, type Locale } from "~/i18n/routes";

interface Props {
  copy: HomeCopy;
  locale: Locale;
}

const { copy, locale } = Astro.props;
---

<section class="section section--surface pricing" id="pricing" aria-labelledby="pricing-heading">
  <div class="shell">
    <h2 id="pricing-heading">{copy.pricing.heading}</h2>
    <p class="lede measure pricing__intro">{copy.pricing.intro}</p>

    <ul class="pricing__tiers">
      {
        copy.pricing.tiers.map((tier) => (
          <li class="pricing__tier card">
            <h3 class="pricing__tier-name">{tier.name}</h3>
            <p class="pricing__tier-covers">{tier.covers}</p>
          </li>
        ))
      }
    </ul>

    <p class="pricing__out">
      <a class="link-out" href={href("pricing", locale)}>{copy.pricing.link}</a>
    </p>
  </div>
</section>

<style>
  .pricing__intro {
    margin-block-start: var(--space-m);
  }

  .pricing__tiers {
    margin-block-start: var(--space-xl);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-m);
  }

  .pricing__tier {
    background: var(--brand-bg);
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
  }

  .pricing__tier-name {
    font-size: var(--step-body-l);
    line-height: 1.3;
  }

  .pricing__tier-covers {
    font-size: var(--step-caption);
    color: var(--brand-ink-muted);
    line-height: var(--leading-body);
  }

  .pricing__out {
    margin-block-start: var(--space-xl);
  }
</style>
