---
/**
 * Guide §3.8. Thirteen module groups as one scannable grid — not seventy tiles.
 * The number 70 appears as a FIGURE, not as a list, which is the guide's
 * instruction and also the only version of this section that a reader finishes.
 *
 * DRAFT COPY. The group names and one-liners are drafted from the module map in
 * praxis-ls README §4; the guide specifies the structure of this section and
 * not its words. Flagged in HANDOFF.md § Draft copy.
 *
 * Each group links to the relevant solution page (guide §3.8). Which page that
 * is comes from one table keyed by the Roman numeral of the module map —
 * src/content/coverage-links.ts — so the English grid and the French grid
 * cannot point at different pages, and the mapping can be reviewed against
 * praxis-ls README §4 without reading either language.
 */
import type { HomeCopy } from "~/content/types";
import { COVERAGE_SOLUTION } from "~/content/coverage-links";
import { SOLUTION_ROUTE } from "~/content/solutions";
import { href, type Locale } from "~/i18n/routes";

interface Props {
  copy: HomeCopy;
  locale: Locale;
}

const { copy, locale } = Astro.props;

/* A group with no mapping would be a cell that silently stops linking, so this
   throws instead — thirteen groups in, thirteen links out. */
const cells = copy.coverage.groups.map((group) => {
  const id = COVERAGE_SOLUTION[group.numeral];
  if (!id) {
    throw new Error(
      `Coverage group ${group.numeral} ("${group.name}") has no solution page in coverage-links.ts.`,
    );
  }
  return { group, url: href(SOLUTION_ROUTE[id], locale) };
});
---

<section class="section section--surface coverage" id="coverage" aria-labelledby="coverage-heading">
  <div class="shell">
    <div class="coverage__head">
      <div>
        <h2 id="coverage-heading">{copy.coverage.heading}</h2>
        <p class="lede measure">{copy.coverage.intro}</p>
      </div>
      <p class="coverage__figure">
        <span class="num coverage__figure-value">{copy.coverage.figure}</span>
        <span class="coverage__figure-label">{copy.coverage.figureLabel}</span>
      </p>
    </div>

    <ul class="coverage__grid">
      {
        cells.map(({ group, url }) => (
          <li class="coverage__cell">
            <span class="num coverage__numeral">{group.numeral}</span>
            <h3 class="coverage__name">
              {/* The whole cell is the target, but only the heading is the
                  link: a screen reader's link list then reads thirteen module
                  groups rather than thirteen repetitions of the one-liner. */}
              <a class="coverage__link" href={url}>
                {group.name}
              </a>
            </h3>
            <p class="coverage__line">{group.line}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .coverage__head {
    display: grid;
    gap: var(--space-m);
    align-items: end;
  }

  .coverage__figure {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
  }

  .coverage__figure-value {
    font-size: var(--step-display-l);
    line-height: 1;
    color: var(--brand-ink-orange);
    font-weight: 600;
  }

  .coverage__figure-label {
    font-size: var(--step-caption);
    color: var(--brand-ink-muted);
  }

  .coverage__grid {
    margin-block-start: var(--space-xl);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1px;
    background: var(--brand-line);
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-l);
    overflow: hidden;
  }

  .coverage__cell {
    position: relative;
    background: var(--brand-bg);
    padding: var(--space-m);
    display: grid;
    gap: var(--space-3xs);
    align-content: start;
  }

  .coverage__cell:hover {
    background: var(--surface-raised);
  }

  /* The heading's link covers the cell, so the one-liner is part of the target
     without being part of the accessible name. The pseudo-element carries no
     text, so nothing is added to the link's name. */
  .coverage__link {
    color: inherit;
    text-decoration: none;
  }

  .coverage__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .coverage__cell:hover .coverage__link {
    color: var(--brand-ink-orange);
  }

  .coverage__link:focus-visible {
    outline: none;
  }

  .coverage__cell:has(.coverage__link:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: -2px;
  }

  .coverage__numeral {
    font-size: var(--step-eyebrow);
    color: var(--brand-ink-slate);
    letter-spacing: 0.08em;
  }

  .coverage__name {
    font-size: var(--step-body);
    line-height: 1.4;
    font-weight: 600;
  }

  .coverage__line {
    font-size: var(--step-caption);
    color: var(--brand-ink-muted);
  }

  @media (width >= 48rem) {
    .coverage__head {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-2xl);
    }
  }
</style>
